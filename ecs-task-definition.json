{
  "family": "macosui-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "macosui-web",
      "image": "<IMAGE_NAME>",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DB_HOST",
          "value": "macosui-postgres.cxi0i02qyh31.ap-northeast-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "macosui"
        },
        {
          "name": "DB_USER",
          "value": "postgres"
        },
        {
          "name": "DB_PASSWORD",
          "value": "macosui_secure_password_123"
        },
        {
          "name": "DB_ENCRYPTION_KEY",
          "value": "7111e8d46f005670e9dda19ead7b11740283c1cd4cd92eb35e271b1b91384fc3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/macosui-oss",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "executionRoleArn": "<EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<EXECUTION_ROLE_ARN>",
  "cpu": "512",
  "memory": "1024"
}
