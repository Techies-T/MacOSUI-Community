PORT=8080

# === Database Configuration ===
# DB_TYPE: 'sqlite' (default, for local/VPS) or 'postgres' (for scalable cloud/Fargate)
DB_TYPE=sqlite

# If DB_TYPE=postgres, configure the connection below:
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=macosui
DB_PORT=5432

# === Encryption Key ===
# Auto-generated locally on first run if missing. Must be set manually in production!
# DB_ENCRYPTION_KEY=your_secure_32_byte_hex_string_here

# === Google OAuth Configuration ===
VITE_GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# === API Keys & Integrations ===
GEMINI_API_KEY=your_gemini_api_key
MCP_CLIENT_ID=your_mcp_client_id
MCP_CLIENT_SECRET=your_mcp_client_secret
MCP_SERVER_ENDPOINT=http://localhost:8000/sse
